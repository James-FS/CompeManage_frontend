{
  "name": "compemanage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:coverage": "cross-env NODE_ENV=coverage vite build",
    "preview": "vite preview",
    "format": "prettier --write --experimental-cli src/",
    "test": "playwright test",
    "test:award-flow": "playwright test --config=playwright.flow.config.js",
    "test:multi-college": "playwright test --config=playwright.multi-college.config.js",
    "test:export-style": "playwright test --config=playwright.export-style.config.js",
    "test:award-boundary": "playwright test --config=playwright.award-boundary.config.js",
    "test:coverage": "npm run build:coverage && nyc --reporter=text --reporter=html --report-dir=coverage playwright test --config=playwright.coverage.config.js",
    "test:unit": "vitest run",
    "test:unit-coverage": "vitest run --coverage --coverage.provider=istanbul --coverage.reporter=json --coverage.reporter=text --coverage.reportsDirectory=coverage-vitest --coverage.include=src/utils/** --coverage.include=src/stores/** --coverage.include=src/api/** --coverage.exclude=src/**/*.test.js",
    "test:coverage:merged": "node scripts/merge-coverage.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/register": "^7.29.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-istanbul": "^2.1.9",
    "babel-plugin-istanbul": "^8.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "nyc": "^18.0.0",
    "playwright-test-coverage": "^1.2.12",
    "prettier": "3.7.4",
    "sass": "^1.97.2",
    "sass-embedded": "^1.97.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.0",
    "vite-plugin-istanbul": "^8.0.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^2.1.9"
  }
}
